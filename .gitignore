# ============================================================
# VEXO Systems — .gitignore
# ============================================================

# ── Environment & Secrets ───────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
server/.env
client/.env
# Allow .env.example everywhere (safe — no real secrets)
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/
pip-wheel-metadata/
share/python-wheels/

# ── Python virtual environments ─────────────────────────────
venv/
.venv/
env/
.env/
ENV/
venv.bak/
.venv.bak/

# ── Python testing & coverage ───────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml
test-results/

# ── Python type checkers ────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Databases & SQLite ──────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity
.pnp.*
.yarn/

# ── Frontend build output ───────────────────────────────────
client/dist/
client/build/
dist/
build/

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── OS & Editor ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# ── Uploads (user-generated content) ────────────────────────
server/uploads/*
!server/uploads/.gitkeep

# ── Alembic runtime ─────────────────────────────────────────
alembic/__pycache__/
alembic/versions/__pycache__/

# ── Misc ────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
*.orig
.cache/
.parcel-cache/
.turbo/
.vercel/
.netlify/
