# ============================================================
# VEXO Systems — Environment Variables Template
# Copy to .env and fill in your actual values.
# NEVER commit .env or this file with real credentials.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (primary — required in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vexo_db

# SQLite fallback is used automatically if DATABASE_URL is unreachable (dev only)

# ── JWT Authentication ────────────────────────────────────────
# MUST be at least 32 characters. Use a strong random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=vexo_super_secret_jwt_key_2026_secure!!

# ── Server ───────────────────────────────────────────────────
PORT=5000
ENVIRONMENT=development
