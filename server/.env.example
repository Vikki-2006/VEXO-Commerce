# ============================================================
# VEXO Systems — Environment Variables Template
# Copy to .env and fill in your actual values.
# NEVER commit .env or this file with real credentials.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (primary — required in production)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/vexo_db

# SQLite fallback is used automatically if DATABASE_URL is unreachable (dev only)

# ── JWT Authentication ────────────────────────────────────────
# MUST be at least 32 characters. Use a strong random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── (Optional) Future integrations ───────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# SENDGRID_API_KEY=SG....
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# OPENAI_API_KEY=sk-...
